# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.pip-cache/
.tmp/

# ---------------------------------------------------------------------------
# Secrets — never commit a real .env
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Credential files kept beside the code for convenience. These patterns have no
# leading slash on purpose, so they match at ANY depth: the first version of this
# file lived in scripts/ and would have been committed by `git add -A`.
.git-token
.git-token.*
*.git-token
*.pat
*.token
.github-token
credentials.json

# ---------------------------------------------------------------------------
# Generated artefacts
# ---------------------------------------------------------------------------
# Rendered SOWs, backlogs and run reports are per-run outputs, not source.
data/artifacts/
data/*.sqlite
data/*.db
*.log

# Chainlit runtime cache
.files/
.chainlit/.files/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker local config (sandbox-friendly DOCKER_CONFIG)
.docker/
