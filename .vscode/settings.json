{
  // ---------------------------------------------------------------------------
  // SOWSprint.ai — workspace settings
  // ---------------------------------------------------------------------------
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // src/ is a src-layout package, so pytest and imports need it on the path when the
  // package is not installed into the interpreter.
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.autoComplete.extraPaths": ["${workspaceFolder}/src"],

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-o", "addopts=", "-q"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.ruff": "explicit" }
  },
  "ruff.configuration": "${workspaceFolder}/pyproject.toml",

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    "**/.playwright": true,
    "**/.pip-cache": true
  },
  "search.exclude": {
    ".venv": true,
    "data/artifacts": true,
    "**/.playwright": true,
    "**/*.lock": true
  },

  // .env is deliberately NOT marked read-only.
  //
  // It was, briefly, to protect the credentials inside — and that was a mistake: it
  // blocks the owner from editing their own keys, which is a normal thing to need to
  // do. The danger was never hand-editing one line; it was rewriting the file in bulk,
  // which is how ten credential fields were once emptied by a pattern match. Use
  // `python scripts/setenv.py KEY VALUE` (or `make set-env KEY=... VALUE=...`) for
  // that, and edit by hand freely.
  "search.useIgnoreFiles": true,
  "search.exclude": { "**/.env": true, "**/.env.*": true },
  "editor.rulers": [100],
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  }
}
