# ---------------------------------------------------------------------------
# SOWSprint.ai — environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in what you have.
#
#   cp .env.example .env
#
# NOTHING here is required. With an empty `.env` the platform boots on its
# deterministic offline engines and completes a full scoping-to-contract run:
# heuristic reasoning, hashing embeddings, an in-process vector store and
# dry-run integrations. Add credentials to upgrade quality, not to enable it.
# ---------------------------------------------------------------------------

# ===========================================================================
# Networking
# ===========================================================================
# Bind 0.0.0.0 (NOT 127.0.0.1) so an iPhone on the same Wi-Fi can reach the app
# at http://<your-lan-ip>:8000. A loopback bind silently breaks mobile testing.
SOWSPRINT_HOST=0.0.0.0
SOWSPRINT_PORT=8000

# Host-side port for docker compose. Change this if 8000 is already taken on your
# machine; the container-internal port stays 8000 either way.
SOWSPRINT_HOST_PORT=8000

SOWSPRINT_ENVIRONMENT=development
SOWSPRINT_LOG_LEVEL=INFO
SOWSPRINT_LOG_JSON=true
SOWSPRINT_DEBUG=false

# Allow escalation from the offline engine to a cloud provider that becomes
# credentialed mid-run. Off by default: a deterministic run is easier to reason about.
SOWSPRINT_ENABLE_CLOUD_FALLBACK=false

# ===========================================================================
# Reasoning providers
# ===========================================================================
# auto | mock | openai | anthropic | groq | ollama
# `auto` picks the best credentialed cloud provider and falls back to the
# deterministic offline engine when no key is present.
SOWSPRINT_LLM_PROVIDER=auto

SOWSPRINT_OPENAI_API_KEY=
SOWSPRINT_ANTHROPIC_API_KEY=
SOWSPRINT_GROQ_API_KEY=
SOWSPRINT_COHERE_API_KEY=

# OpenAI-compatible gateway override (Azure OpenAI, vLLM, LiteLLM, OpenRouter).
SOWSPRINT_OPENAI_BASE_URL=
SOWSPRINT_ANTHROPIC_BASE_URL=

# Self-hosted Ollama, used as the on-premise guardrail tier.
SOWSPRINT_OLLAMA_BASE_URL=http://localhost:11434

# Quality tiers. `critic_model` and `fast_model` inherit `reasoning_model` when
# left blank, so a single-provider setup needs one model id rather than three.
SOWSPRINT_REASONING_MODEL=claude-haiku-5-5
SOWSPRINT_CRITIC_MODEL=gpt-5.1
SOWSPRINT_FAST_MODEL=claude-haiku-5-5

# Provider serving the Critic node. `auto` reuses the reasoning provider.
#
# Point this at a DIFFERENT vendor than the drafting agent for genuine judge
# independence: a model auditing its own output is measurably weaker at catching its
# own hallucinations. Setting a cross-vendor model id without this setting does not
# work — the id would be posted to the wrong API.
SOWSPRINT_CRITIC_PROVIDER=openai

SOWSPRINT_TEMPERATURE=0.1
SOWSPRINT_MAX_TOKENS=4096
# Read timeout: how long to wait for tokens once a request is in flight. Generous on
# purpose — cutting off a large structured completion mid-JSON is worse than waiting.
SOWSPRINT_REQUEST_TIMEOUT_S=120

# Connect timeout, kept short and separate. With one shared budget an unreachable
# endpoint burns the full read timeout on every attempt — minutes of a hung chat
# before the fallback provider is allowed to engage.
SOWSPRINT_CONNECT_TIMEOUT_S=10

# Attempts per call. One may be consumed by output-budget escalation on truncation.
SOWSPRINT_MAX_RETRIES=4

# ===========================================================================
# Vector storage
# ===========================================================================
# auto | qdrant | memory   (`auto` degrades to `memory` if Qdrant is unreachable)
SOWSPRINT_VECTOR_BACKEND=qdrant
SOWSPRINT_QDRANT_URL=http://localhost:6333
SOWSPRINT_QDRANT_API_KEY=
SOWSPRINT_QDRANT_COLLECTION=sowsprint_legal

# ===========================================================================
# Embeddings and reranking
# ===========================================================================
# auto | hash | openai | ollama
SOWSPRINT_EMBEDDING_PROVIDER=auto
SOWSPRINT_EMBEDDING_MODEL=text-embedding-3-small
# MUST match the Qdrant collection's vector size. text-embedding-3-small = 1536.
SOWSPRINT_EMBEDDING_DIM=1536

# auto | heuristic | cohere | tei
SOWSPRINT_RERANK_PROVIDER=auto
SOWSPRINT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Self-hosted BGE reranker (HuggingFace text-embeddings-inference).
SOWSPRINT_TEI_RERANK_URL=

# Hybrid retrieval tuning
SOWSPRINT_RETRIEVAL_TOP_K=20
SOWSPRINT_RETRIEVAL_FINAL_K=5
SOWSPRINT_RRF_K=60
SOWSPRINT_CHUNK_SIZE=1100
SOWSPRINT_CHUNK_OVERLAP=150
SOWSPRINT_DEFAULT_JURISDICTION=EU

# ===========================================================================
# Guardrails
# ===========================================================================
# The graph halts rather than exceeding this per-session ceiling.
SOWSPRINT_SESSION_BUDGET_USD=2.50
# How many times a failed quality audit may bounce back to the drafting agent.
SOWSPRINT_MAX_CRITIC_RETRIES=1

# ===========================================================================
# Jira integration
# ===========================================================================
# Leave SOWSPRINT_DRY_RUN_INTEGRATIONS=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# ON by default. The application spends real money on model calls and writes to Jira
# and Notion, and it binds 0.0.0.0 so a phone on the same Wi-Fi can reach it — which
# also means anything else on that network can. An open deployment should be an
# explicit decision, not an inherited default.
SOWSPRINT_AUTH_ENABLED=true

# Chainlit refuses to start with authentication enabled unless it has a secret for
# signing the session cookie. Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=

# Human accounts: a JSON array. Generate with:
#   python -m sowsprint.security.passwd --user you --json
#
# Digests are scrypt and dot-separated, NOT the conventional dollar-separated form.
# Docker Compose interpolates `$` in this file, so `scrypt$16384$8$...` reaches the
# container as `scrypt` and every login fails with a correct password. The tool emits
# the safe form; do not hand-edit a digest into the dollar form.
SOWSPRINT_AUTH_USERS=

# Machine accounts for the verification harnesses and CI, as name:key pairs.
#   python -m sowsprint.security.passwd --api-key ci
#
# Unattended callers authenticate by exchanging the key at POST /auth/header for a
# short-lived cookie, so no script ever carries a human's password.
SOWSPRINT_AUTH_API_KEYS= until you have verified the payloads
# in the UI. With dry-run on, requests are built and validated but never sent.
SOWSPRINT_DRY_RUN_INTEGRATIONS=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# ON by default. The application spends real money on model calls and writes to Jira
# and Notion, and it binds 0.0.0.0 so a phone on the same Wi-Fi can reach it — which
# also means anything else on that network can. An open deployment should be an
# explicit decision, not an inherited default.
SOWSPRINT_AUTH_ENABLED=true

# Chainlit refuses to start with authentication enabled unless it has a secret for
# signing the session cookie. Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=

# Human accounts: a JSON array. Generate with:
#   python -m sowsprint.security.passwd --user you --json
#
# Digests are scrypt and dot-separated, NOT the conventional dollar-separated form.
# Docker Compose interpolates `$` in this file, so `scrypt$16384$8$...` reaches the
# container as `scrypt` and every login fails with a correct password. The tool emits
# the safe form; do not hand-edit a digest into the dollar form.
SOWSPRINT_AUTH_USERS=

# Machine accounts for the verification harnesses and CI, as name:key pairs.
#   python -m sowsprint.security.passwd --api-key ci
#
# Unattended callers authenticate by exchanging the key at POST /auth/header for a
# short-lived cookie, so no script ever carries a human's password.
SOWSPRINT_AUTH_API_KEYS=
SOWSPRINT_JIRA_BASE_URL=
SOWSPRINT_JIRA_EMAIL=
SOWSPRINT_JIRA_API_TOKEN=
SOWSPRINT_JIRA_PROJECT_KEY=

# ===========================================================================
# Notion integration
# ===========================================================================
SOWSPRINT_NOTION_API_KEY=
SOWSPRINT_NOTION_PARENT_PAGE_ID=

# ===========================================================================
# Voice scoping (speech-to-text)
# ===========================================================================
# auto | openai | groq | local | offline
# `auto` prefers a self-hosted endpoint, then Groq, then OpenAI.
SOWSPRINT_WHISPER_PROVIDER=auto

SOWSPRINT_WHISPER_MODEL=whisper-1
# Groq's turbo model is the lowest-latency hosted option for phone dictation.
SOWSPRINT_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Self-hosted, OpenAI-compatible speech-to-text. Anything speaking the
# /v1/audio/transcriptions contract works: faster-whisper-server, whisper.cpp
# `server`, Speaches, vLLM.
#
# When this is set it WINS over the cloud keys below, so a dictated requirement —
# often the most confidential artefact in the whole flow — never leaves your network.
#
#   SOWSPRINT_WHISPER_BASE_URL=http://whisper:8000/v1
#   SOWSPRINT_WHISPER_MODEL=Systran/faster-whisper-small
#
# Most self-hosted servers ignore auth; leave the key blank unless yours requires one.
SOWSPRINT_WHISPER_BASE_URL=
SOWSPRINT_WHISPER_API_KEY=

# Must match [features.audio].sample_rate in .chainlit/config.toml. The capture
# widget streams headerless mono PCM at this rate; a mismatch yields pitch-shifted
# audio and a poor transcript.
SOWSPRINT_AUDIO_SAMPLE_RATE=24000
SOWSPRINT_MAX_AUDIO_MB=25
